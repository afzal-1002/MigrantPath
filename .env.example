# Copy to .env for local development: `cp .env.example .env`
# Never commit the real .env file (see .gitignore). No real secrets belong in this
# example file - every value below is a development-only placeholder.

# --- PostgreSQL (used by both docker-compose.yml and the backend's local profile) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=foreigner_warsaw
DB_USERNAME=foreigner_warsaw
DB_PASSWORD=foreigner_warsaw_local_dev_only

# docker-compose.yml reads these to initialize the Postgres container itself.
# Keep them equal to DB_NAME/DB_USERNAME/DB_PASSWORD above.
POSTGRES_DB=foreigner_warsaw
POSTGRES_USER=foreigner_warsaw
POSTGRES_PASSWORD=foreigner_warsaw_local_dev_only

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:4200

# --- Mail (Mailpit locally - see docker-compose.yml; no auth needed for Mailpit) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Reserved for Phase 2 (not used yet) ---
# ADMIN_INITIAL_EMAIL=
