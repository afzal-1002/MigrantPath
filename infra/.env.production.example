# Copy to infra/.env.production (or, better, inject these same variables through your
# deployment platform's own secret store and skip a file entirely - see
# docs/operations/DEPLOYMENT.md). Never commit the real file (see repo .gitignore).
# Every value below is a placeholder - no real secret has ever been in this file.

# --- Public URL (brief §121/§122) - used to build verification/reset email links and
# the sitemap; must be the real HTTPS production domain, never localhost. ---
APP_PUBLIC_URL=https://example.com

# --- Database (brief §25/§26/§166 - managed Postgres 18 recommended; point DB_HOST at
# it directly and omit --profile self-hosted-db, or set DB_HOST=postgres and add that
# profile flag to use the bundled container instead) ---
DB_HOST=
DB_PORT=5432
DB_NAME=foreigner_warsaw
DB_USERNAME=
DB_PASSWORD=

# --- Mail (brief §54 - a real transactional SMTP provider; never Mailpit/localhost) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Reverse-proxy port the frontend container listens on (fronted by your real TLS
# terminator - see docs/operations/DEPLOYMENT.md) ---
HTTP_PORT=8080

# --- Image tagging (brief §77 - never "latest" only in a real release; set IMAGE_TAG
# to a real git SHA or semver before deploying) ---
IMAGE_TAG=
BUILD_COMMIT=

# --- Admin bootstrap (brief §24) - set only for the single startup that creates the
# first ADMIN account, then unset both and redeploy/restart. Leave both blank on every
# other startup - the bootstrap runner is a permanent no-op once any ADMIN exists. ---
APP_ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
