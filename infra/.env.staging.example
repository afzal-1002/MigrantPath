# Copy to infra/.env.staging (or, better, inject these same variables through your
# deployment platform's own secret store and skip a file entirely - see
# docs/operations/STAGING.md). Never commit the real file (see repo .gitignore, which
# already ignores infra/.env.staging - brief §119).
#
# Staging uses the SAME infra/docker-compose.prod.yml as production (brief §5 - "do not
# use Angular dev server as staging", "staging should match production architecture
# closely") - only the values below differ: a separate database, separate/sandboxed
# mail, and the staging domain. See docs/operations/ENVIRONMENT_VARIABLES.md for what
# every variable means; this file only fills in the staging-specific placeholders.

# --- Public URL - the real staging HTTPS domain, never the production domain and never
# localhost (brief §6/§34). ---
APP_PUBLIC_URL=https://staging.example.com

# --- Database - a dedicated staging Postgres instance, NEVER the production database
# and NEVER a raw copy/restore of production data without an anonymization pass that
# does not exist yet (brief §161/§187 - ENVIRONMENTS.md's own "staging never points at
# the production database" rule). ---
DB_HOST=
DB_PORT=5432
DB_NAME=foreigner_warsaw_staging
DB_USERNAME=
DB_PASSWORD=

# --- Mail - a sandboxed/test-only SMTP provider or dedicated staging sender identity
# (brief §35/§182). Never point staging at the same provider account/domain production
# uses for outbound mail - a staging E2E run must never be able to reach a real user's
# inbox. ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Reverse-proxy port the frontend container listens on (fronted by staging's own TLS
# terminator - see docs/operations/DNS_AND_TLS.md) ---
HTTP_PORT=8080

# --- Image tagging (brief §77) - staging always runs the exact same immutable image
# that will be promoted to production (brief §7 "build once, promote"), never a
# separately rebuilt one. ---
IMAGE_TAG=
BUILD_COMMIT=

# --- Admin bootstrap - set only for the single startup that creates staging's own first
# ADMIN account (a synthetic/test identity, distinct from any production admin), then
# unset both and redeploy. ---
APP_ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
