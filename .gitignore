# Secrets / environment
.env
.env.*.local
# Phase 11 real per-environment env files (infra/.env.production, .env.staging, etc.)
# - deliberately explicit patterns, not a broad ".env.*" + negation (gitignore's
# negation-after-wildcard-exclusion interaction is easy to get subtly wrong - verified
# these specific patterns behave correctly with `git check-ignore -v`, unlike an
# earlier ".env.*" + "!*.example" attempt that did not). *.example files (committed,
# placeholders only) are never matched by any pattern below.
.env.production
.env.staging
infra/.env.production
infra/.env.staging

# Claude Code harness session/task state (not project source)
.claude/

# Backend (Maven / Java) - the wrapper scripts (mvnw, mvnw.cmd,
# .mvn/wrapper/maven-wrapper.properties) ARE committed and required - see
# IMPLEMENTATION_PLAN.md 1.1. This wrapper uses distributionType=only-script, so there
# is no maven-wrapper.jar to worry about either way.
backend/target/
*.class

# Frontend (Angular / Node)
frontend/node_modules/
frontend/dist/
frontend/.angular/
npm-debug.log*

# Playwright
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/

# Logs
*.log
logs/

# IDE
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Local database volumes if ever bind-mounted instead of a named volume
/pgdata/
